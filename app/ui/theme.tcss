Screen { background: #10141b; color: #d8dee9; }
HeaderBar, FooterBar { height: 3; background: #171d26; border: solid #303a49; padding: 1 2; }
#brand { color: #83d6c5; text-style: bold; width: 20; }
#release, #shortcuts { color: #8290a5; }
#breadcrumb { color: #e5c07b; width: 1fr; text-align: right; }
#shortcuts { text-align: center; width: 1fr; }
#content { margin: 1 2; padding: 1 2; border: solid #303a49; background: #141a22; }
#home-actions { color: #e5c07b; margin-bottom: 1; padding: 0 1; border: solid #303a49; }
.section-title { color: #83d6c5; text-style: bold; }
.section-caption { color: #8290a5; margin-bottom: 1; }
#table-host { height: 1fr; }
#storage-table { height: 1fr; border: solid #364153; }
DataTable > .datatable--header { background: #202936; color: #83d6c5; text-style: bold; }
DataTable > .datatable--cursor { background: #263447; color: #ffffff; }
DataTable > .datatable--even-row { background: #141a22; }
DataTable > .datatable--odd-row { background: #19212c; }
DataTable > .datatable--cursor { background: #2b4058; text-style: bold; }
#empty-state { height: 1fr; content-align: center middle; color: #8290a5; }
DiskDetailsDialog { align: center middle; background: rgba(0, 0, 0, 0.72); }
#details-dialog { width: 76; height: 70%; padding: 1 2; border: double #83d6c5; background: #171d26; }
#dialog-title { color: #83d6c5; text-style: bold; margin-bottom: 1; }
.detail-section { border: solid #303a49; padding: 0 1; margin-bottom: 1; }
.detail-section-title { color: #e5c07b; text-style: bold; padding: 0 1; }
.detail-row { height: 2; }
.detail-key { width: 24; padding: 0 1; }
.detail-value { width: 1fr; padding: 0 1; }
#dialog-shortcut { color: #e5c07b; text-style: bold; margin: 1 0; }
#close-dialog { dock: bottom; width: 18; margin-top: 1; }
#benchmark-content, #results-content, #history-content, #comparison-content { margin: 1 2; padding: 1 2; border: solid #303a49; background: #141a22; }
#benchmark-progress { margin: 1 0; }
#benchmark-current, #benchmark-remaining, #benchmark-timing, #export-message, #history-message { color: #d8dee9; margin: 1 0; }
#cancel-benchmark { margin-top: 1; }
#results-table, #history-table, #comparison-table { height: 1fr; border: solid #364153; }
#results-charts, #history-chart, #comparison-chart { color: #83d6c5; padding: 1; height: auto; }
#benchmark-detail-content, #settings-dialog { margin: 1 2; padding: 1 2; border: solid #303a49; background: #141a22; }
#benchmark-charts { color: #83d6c5; padding: 1; }
#settings-dialog { width: 72; height: 80%; }
#settings-title { color: #83d6c5; text-style: bold; }
.settings-field { height: 5; }
.settings-label { color: #e5c07b; }
#settings-actions { height: 3; margin-top: 1; }
#settings-actions Button { margin-right: 1; }
#settings-hint, #settings-message, #comparison-message { color: #8290a5; margin: 1 0; }
#profile-dialog { width: 64; height: auto; padding: 2; border: double #83d6c5; background: #171d26; }
#profile-dialog-title { color: #83d6c5; text-style: bold; margin-bottom: 1; }
#profile-dialog Button { width: 1fr; margin-top: 1; }
#profile-dialog-shortcut { color: #e5c07b; margin-top: 1; }
.theme-light Screen { background: #f4f6f8; color: #1f2933; }
.theme-light HeaderBar, .theme-light FooterBar { background: #e4e7eb; border: solid #9aa5b1; }
.theme-light #content, .theme-light #benchmark-content, .theme-light #results-content, .theme-light #history-content, .theme-light #comparison-content { background: #ffffff; border: solid #9aa5b1; }
.theme-light #brand, .theme-light .section-title { color: #0b7285; }
.theme-light #release, .theme-light #shortcuts, .theme-light .section-caption { color: #52606d; }
.theme-light #breadcrumb { color: #9a6700; }
